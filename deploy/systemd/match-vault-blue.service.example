[Unit]
Description=Match Vault Spring Boot application (Blue)
After=network.target

[Service]
User=match-vault
Group=match-vault
WorkingDirectory=/opt/match-vault/blue
EnvironmentFile=/etc/match-vault/match-vault.env
ExecStart=/usr/bin/java -jar /opt/match-vault/blue/backend/app.jar --server.port=8082 --server.address=127.0.0.1
SuccessExitStatus=143
Restart=always
RestartSec=5
TimeoutStopSec=32min

[Install]
WantedBy=multi-user.target
